# PlacePro - Environment Configuration Template
# -----------------------------------------------------------------------------
# Copy this file to .env.local and populate with your institutional secrets.
# NEVER commit the actual .env.local file to version control.

# --- Supabase Public Configuration ---
# Found in Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase Private Configuration ---
# Required for administrative operations and secure API routes.
# Keep this secret!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Application Configuration ---
# The primary domain of your deployment (e.g., https://placepro.in)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Optional institutional branding ---
INSTITUTION_NAME="MIT-ADT University"
TPO_OFFICE_NAME="Placement Office"
